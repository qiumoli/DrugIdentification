<view class="container">
  <!-- 顶部栏（返回按钮+标题） -->
  <view class="top-bar">
    <view class="back-btn" bindtap="goBack">
      <text>返回</text>
    </view>
    <view class="header">银发伴行-识药助手</view>
  </view>

  <!-- 用药说明大方框 -->
  <view class="result-box">
    <view class="result-title">药要这样吃：</view>
    <text class="result-content">{{simplifiedText}}</text>
  </view>

  <!-- 超大播放按钮 -->
  <view class="play-btn" bindtap="playAudio">
    <text>🔊 {{isPlaying ? '重新播放' : '播放'}}用药说明</text>
  </view>

    <!-- 停止播放按钮（播放时显示） -->
    <view wx:if="{{isPlaying}}" class="audio-btn stop-btn" bindtap="stopAudio">
      <text class="btn-icon">🔇</text>
      <text class="btn-text">停止播放</text>
    </view>
  </view>