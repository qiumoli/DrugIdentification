<view class="container">
  <!-- 顶部标题区（占1/4页面+拆分换行） -->
  <view class="title-box">
    <text class="title-main">银发伴行</text>
    <text class="title-sub">识药助手</text>
  </view>

   <!-- 新增：跳过识别小按钮 !!有待删除！！！-->
   <view class="skip-btn" bindtap="jumpToResult">
    <text>跳过识别</text>
  </view>
  
  <!-- 占位区（把按钮挤到下方） -->
  <view class="placeholder"></view>

  <!-- 拍照按钮（占1/3页面+靠下） -->
  <view class="camera-btn" bindtap="uploadImage" wx:if="{{!isLoading}}">
    <text>点我拍照识药</text>
  </view>
  <!-- 加载态按钮 -->
  <view class="camera-btn loading-btn" wx:else>
    <text>正在准备相机...</text>
  </view>
</view>

  