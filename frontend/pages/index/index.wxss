page {
  background-color: #f5f5f5;
  height: 100vh;
  margin: 0;
  padding: 0;
}

/* 容器 */
.container {
  padding: 0rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
  justify-content: flex-start;
}

/* 顶部标题（放大+改字体） */
.title-box {
  width: 100%;
  height: auto;  
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding-top: 20rpx;    /* 只留一点点顶部距离 */
  margin: 0; 
}

/* 主标题（银发伴行-放大） */
.title-main {
  font-size: 100rpx; /* 超大主标题 */
  font-weight: bold;
  font-family: "STKaiti", "KaiTi", serif;
  color: #222;
  display: block; /* 强制换行 */
  margin-bottom: 5rpx;
}

/* 副标题（识药助手-略小） */
.title-sub {
  font-size: 80rpx; /* 比主标题小 */
  font-weight: bold;
  font-family: "STKaiti", "KaiTi", serif;
  color: #222;
  display: block; /* 强制换行 */
}

/* 历史记录按钮 - 放在标题和大按钮中间，居中 */
.history-btn {
  font-size: 50rpx;
  color: #07c160;
  padding: 10rpx 20rpx;
  border: 1rpx solid #07c160;
  border-radius: 20rpx;
  margin: 20rpx 0 30rpx 0; /* 上下间距，居中 */
}
.history-btn:active {
  background-color: #f0f9f0;
}

/* 拍照按钮（紧贴视频按钮，无空隙） */
.camera-btn {
  background-color: #07c160;
  color: white;
  width: 90%;
  height: calc(100vh / 4);
  border-radius: 30rpx;
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.3);
  margin: 0; /* 无下边距 → 紧贴下面按钮 */
}

/* 视频按钮（直接贴在拍照按钮下面） */
.video-btn {
  background-color: #56c9fe;
  color: white;
  width: 90%;
  height: calc(100vh / 4.5);
  border-radius: 30rpx;
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(86, 201, 254, 0.3);
  margin: 0; /* 无间距 */
  margin-top: 20rpx; /* 如果你想要一点点缝隙，用这个；不要就写 0 */
}

/* 加载态按钮 */
.loading-btn {
  background-color: #999;
  pointer-events: none;
}

/* 占位区删除，不需要了 */
.placeholder {
  display: none;
}

