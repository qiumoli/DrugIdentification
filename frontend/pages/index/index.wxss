/* 容器 */
.container {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部标题（放大+改字体） */
.title-box {
  width: 100%;
  height: calc(100vh / 4); /* 占页面1/4高度 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 主标题（银发伴行-放大） */
.title-main {
  font-size: 100rpx; /* 超大主标题 */
  font-weight: bold;
  font-family: "STKaiti", "KaiTi", serif;
  color: #222;
  display: block; /* 强制换行 */
  margin-bottom: 20rpx;
}

/* 副标题（识药助手-略小） */
.title-sub {
  font-size: 70rpx; /* 比主标题小 */
  font-weight: bold;
  font-family: "STKaiti", "KaiTi", serif;
  color: #222;
  display: block; /* 强制换行 */
}

/* 新增：跳过识别小按钮样式 ！！！有待删除！！！！*/
.skip-btn {
  font-size: 28rpx; /* 小号字体，不抢焦点 */
  color: #666; /* 浅灰色，低调 */
  padding: 10rpx 20rpx; /* 小巧的点击区域 */
  margin-bottom: 20rpx; /* 和下方占位区留少量间距 */
  border: 1rpx solid #ddd; /* 浅边框，区分点击区域 */
  border-radius: 20rpx; /* 圆角，更柔和 */
}
/* 点击按钮时的态（可选） */
.skip-btn:active {
  background-color: #f0f0f0;
}


/* 占位区（把按钮挤到下方） */
.placeholder {
  flex: 1; /* 占满上方空间 */
}

/* 拍照按钮（占1/3页面+靠下） */
.camera-btn {
  background-color: #07c160;
  color: white;
  width: 90%;
  height: calc(100vh / 3); /* 占页面1/3高度 */
  border-radius: 30rpx;
  font-size: 48rpx; /* 超大按钮文字 */
  font-weight: bold;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 60rpx; /* 靠下留边距 */
}

/* 加载态按钮 */
.loading-btn {
  background-color: #999;
  pointer-events: none;
}