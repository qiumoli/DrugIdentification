page {
  background-color: #f5f5f5;
}

.container {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部栏样式（和result页面保持一致） */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
  position: relative;
}

.back-btn {
  font-size: 50rpx;
  font-weight: bold;
  color: #07c160;
  padding: 10rpx 20rpx;
  position: absolute;
  left: -200rpx;    /* 贴死最左 */
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}
.header {
  font-size: 60rpx;
  font-weight: bold;
  font-family: "STKaiti", "KaiTi", serif;
  color: #222;
  flex: 1;
  text-align: center;
  margin: 0;
}

/* 历史记录列表 */
.history-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 无记录提示 */
.empty-tip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
}

/* 历史记录卡片 */
.history-item {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.item-content {
  font-size: 36rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.item-time {
  font-size: 28rpx;
  color: #999;
  text-align: right;
}

/* 清空按钮 */
.clear-btn {
  background-color: #f56c6c;
  color: white;
  width: 100%;
  padding: 20rpx 0;
  border-radius: 30rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}